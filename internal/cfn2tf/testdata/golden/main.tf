resource "aws_sns_topic" "reservation_events_topic" {
  name         = "reservation-events-${var.environment}"
  display_name = "Reservation events"
  tags = {
    team = "platform"
  }
}

resource "aws_sqs_queue" "channel_sync_dead_letter_queue" {
  name                      = "channel-sync-dlq-${var.environment}"
  message_retention_seconds = 1209600
}

resource "aws_sqs_queue" "channel_sync_queue" {
  name                       = "channel-sync-${var.environment}"
  receive_wait_time_seconds  = 20
  visibility_timeout_seconds = 120
  redrive_policy = jsonencode({
    deadLetterTargetArn = aws_sqs_queue.channel_sync_dead_letter_queue.arn
    maxReceiveCount     = 5
  })
  tags = {
    team     = "platform"
    consumer = "channel-sync"
  }
}

resource "aws_sqs_queue_policy" "channel_sync_queue_policy" {
  queue_url = aws_sqs_queue.channel_sync_queue.url
  policy = jsonencode({
    Statement = [
      {
        Action = "sqs:SendMessage"
        Condition = {
          ArnEquals = {
            "aws:SourceArn" = aws_sns_topic.reservation_events_topic.arn
          }
        }
        Effect = "Allow"
        Principal = {
          Service = "sns.amazonaws.com"
        }
        Resource = aws_sqs_queue.channel_sync_queue.arn
        Sid      = "AllowReservationEvents"
      },
    ]
    Version = "2012-10-17"
  })
}

resource "aws_sns_topic_subscription" "channel_sync_subscription" {
  topic_arn            = aws_sns_topic.reservation_events_topic.arn
  protocol             = "sqs"
  endpoint             = aws_sqs_queue.channel_sync_queue.arn
  raw_message_delivery = true
  filter_policy = jsonencode({
    event_type = ["reservation.created", "reservation.amended", "reservation.cancelled"]
  })

  lifecycle {
    ignore_changes = [confirmation_timeout_in_minutes, endpoint_auto_confirms]
  }
}

resource "aws_s3_bucket" "exports_bucket" {
  bucket = "pms-exports-${var.environment}-${data.aws_caller_identity.current.account_id}"
  tags = {
    team = "platform"
  }
}

resource "aws_s3_bucket_versioning" "exports_bucket" {
  bucket = aws_s3_bucket.exports_bucket.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "exports_bucket" {
  bucket = aws_s3_bucket.exports_bucket.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "exports_bucket" {
  bucket = aws_s3_bucket.exports_bucket.id

  rule {
    id     = "expire-exports"
    status = "Enabled"

    filter {
      prefix = "exports/"
    }

    expiration {
      days = var.export_retention_days
    }

    noncurrent_version_expiration {
      noncurrent_days = 7
    }
  }

  rule {
    id     = "archive-audit"
    status = "Enabled"

    filter {
      prefix = "audit/"
    }

    transition {
      days          = 30
      storage_class = "GLACIER"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "exports_bucket" {
  bucket                  = aws_s3_bucket.exports_bucket.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_dynamodb_table" "idempotency_table" {
  name         = "channel-sync-idempotency-${var.environment}"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "request_key"

  attribute {
    name = "request_key"
    type = "S"
  }

  attribute {
    name = "account_id"
    type = "S"
  }

  global_secondary_index {
    name            = "by-account"
    hash_key        = "account_id"
    projection_type = "KEYS_ONLY"
  }

  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }
}

resource "aws_cloudwatch_log_group" "worker_log_group" {
  name              = "/pms/${var.environment}/channel-sync"
  retention_in_days = 14
}

resource "aws_ssm_parameter" "channel_sync_endpoint_parameter" {
  name        = "/pms/${var.environment}/channel-sync/queue-url"
  type        = "String"
  value       = aws_sqs_queue.channel_sync_queue.url
  description = "Where the channel sync worker reads from"
}

resource "aws_iam_role" "worker_role" {
  name = "channel-sync-worker-${var.environment}"
  assume_role_policy = jsonencode({
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
      },
    ]
    Version = "2012-10-17"
  })
  tags = {
    team = "platform"
  }
}

resource "aws_iam_role_policy" "worker_role_consume_channel_sync" {
  name = "consume-channel-sync"
  role = aws_iam_role.worker_role.name
  policy = jsonencode({
    Statement = [
      {
        Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
        Effect   = "Allow"
        Resource = aws_sqs_queue.channel_sync_queue.arn
      },
      {
        Action   = ["dynamodb:PutItem", "dynamodb:GetItem"]
        Effect   = "Allow"
        Resource = aws_dynamodb_table.idempotency_table.arn
      },
    ]
    Version = "2012-10-17"
  })
}

resource "aws_iam_role_policy_attachment" "worker_role_0" {
  role       = aws_iam_role.worker_role.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/CloudWatchLogsReadOnlyAccess"
}

resource "aws_iam_role_policy" "worker_exports_policy" {
  name = "write-exports"
  role = aws_iam_role.worker_role.name
  policy = jsonencode({
    Statement = [
      {
        Action   = "s3:PutObject"
        Effect   = "Allow"
        Resource = "${aws_s3_bucket.exports_bucket.arn}/exports/*"
      },
      {
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
        Effect   = "Allow"
        Resource = "${aws_cloudwatch_log_group.worker_log_group.arn}:*"
      },
    ]
    Version = "2012-10-17"
  })
